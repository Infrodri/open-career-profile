# =============================================================================
# Open Career Profile — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# For local development (Docker PostgreSQL accessible on host):
OCP_DATABASE_URL=postgresql://ocp:ocp_dev_password@localhost:5433/ocp_dev

# For Docker Compose (internal network, used by the API container):
# OCP_DATABASE_URL=postgresql://ocp:ocp_dev_password@postgres:5432/ocp_dev

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
OCP_PORT=3000

# -----------------------------------------------------------------------------
# AI Provider (optional — system works without AI)
# -----------------------------------------------------------------------------
# Supports any OpenAI-compatible API: OpenAI, Ollama, OpenRouter, Together, etc.
OCP_AI_BASE_URL=http://localhost:11434/v1
OCP_AI_API_KEY=
OCP_AI_MODEL=llama3
OCP_AI_MAX_TOKENS=1000
OCP_AI_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# OCR (optional — enabled by default)
# -----------------------------------------------------------------------------
OCP_OCR_ENABLED=true
OCP_OCR_LANGUAGE=eng

# =============================================================================
# Docker Compose Deployment
# =============================================================================
# To deploy the full stack with a single command:
#
#   cd docker
#   docker compose up --build
#
# Services:
#   - PostgreSQL:  localhost:5432
#   - API:         localhost:3000
#   - Web:         localhost:5173
#
# The docker-compose.yml already sets OCP_DATABASE_URL and OCP_PORT for the
# API container. You only need a .env file for local (non-Docker) development.
# =============================================================================
