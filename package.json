{
  "name": "open-career-profile",
  "version": "0.0.1",
  "private": true,
  "description": "Open Source platform to build and maintain a Professional Profile locally and privately",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "plugins/*"
  ],
  "scripts": {
