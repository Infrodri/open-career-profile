{
  "name": "@ocp/api",
  "version": "0.0.1",
  "private": true,
  "description": "REST API for Open Career Profile",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ocp/core": "*",
    "@ocp/persistence": "*",
    "@ocp/output-engine": "*",
    "@prisma/client": "6.9.0",
    "express": "4.21.2",
    "helmet": "8.1.0",
    "cors": "2.8.5",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/express": "5.0.2",
    "@types/cors": "2.8.17",
    "tsx": "4.19.4",
    "supertest": "7.1.0",
    "@types/supertest": "6.0.2",
    "vitest": "3.1.4",
    "typescript": "5.8.3"
  }
}
