<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{personalInfo.fullName}} - Professional CV</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      font-size: 11pt;
      line-height: 1.5;
      color: #2d2d2d;
    }
    .container { max-width: 800px; margin: 0 auto; padding: 20px; }
    .header {
      text-align: center;
      border-bottom: 2px solid #3b82f6;
      padding-bottom: 16px;
      margin-bottom: 24px;
    }
    .header h1 { font-size: 24pt; color: #1e3a5f; margin-bottom: 8px; }
    .contact-info { font-size: 10pt; color: #555; }
    .contact-info span { margin: 0 8px; }
    .summary { margin-bottom: 24px; font-style: italic; color: #444; }
    .section { margin-bottom: 20px; }
    .section-title {
      font-size: 13pt;
      color: #1e3a5f;
      border-bottom: 1px solid #ddd;
      padding-bottom: 4px;
      margin-bottom: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .entry { margin-bottom: 14px; }
    .entry-header { display: flex; justify-content: space-between; align-items: baseline; }
    .entry-title { font-weight: 600; font-size: 11pt; }
    .entry-subtitle { color: #555; font-size: 10pt; }
    .entry-date { color: #777; font-size: 9pt; white-space: nowrap; }
    .entry-description { margin-top: 4px; font-size: 10pt; color: #444; }
    .achievements { list-style: disc; margin-left: 20px; margin-top: 4px; font-size: 10pt; }
    .skills-grid { display: flex; flex-wrap: wrap; gap: 8px; }
    .skill-tag {
      background: #e8f0fe;
      color: #1e3a5f;
      padding: 4px 10px;
      border-radius: 4px;
      font-size: 9pt;
    }
    .skill-level { color: #777; font-size: 8pt; margin-left: 4px; }
    .links { font-size: 9pt; margin-top: 4px; }
    .links a { color: #3b82f6; text-decoration: none; }
  </style>
</head>
<body>
  <div class="container">
    <header class="header">
      <h1>{{personalInfo.fullName}}</h1>
      <div class="contact-info">
        {{#if personalInfo.email}}<span>{{personalInfo.email}}</span>{{/if}}
        {{#if personalInfo.phone}}<span>{{personalInfo.phone}}</span>{{/if}}
        {{#if personalInfo.city}}<span>{{personalInfo.city}}{{#if personalInfo.country}}, {{personalInfo.country}}{{/if}}</span>{{/if}}
      </div>
      {{#if personalInfo.links.length}}
      <div class="links">
        {{#each personalInfo.links}}<a href="{{this.url}}">{{this.label}}</a>{{#unless @last}} | {{/unless}}{{/each}}
      </div>
      {{/if}}
    </header>

    {{#if personalInfo.summary}}
    <div class="summary">
      <p>{{personalInfo.summary}}</p>
    </div>
    {{/if}}

    {{#if sections.workExperience.length}}
    <section class="section">
      <h2 class="section-title">Work Experience</h2>
      {{#each sections.workExperience}}
      <div class="entry">
        <div class="entry-header">
          <div>
            <div class="entry-title">{{this.position}}</div>
            <div class="entry-subtitle">{{this.institution}}{{#if this.location}} — {{this.location}}{{/if}}</div>
          </div>
          <div class="entry-date">{{this.startDate}}{{#if this.endDate}} – {{this.endDate}}{{/if}}</div>
        </div>
        {{#if this.description}}<div class="entry-description">{{this.description}}</div>{{/if}}
        {{#if this.achievements.length}}
        <ul class="achievements">
          {{#each this.achievements}}<li>{{this}}</li>{{/each}}
        </ul>
        {{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if sections.education.length}}
    <section class="section">
      <h2 class="section-title">Education</h2>
      {{#each sections.education}}
      <div class="entry">
        <div class="entry-header">
          <div>
            <div class="entry-title">{{this.title}}</div>
            <div class="entry-subtitle">{{this.institution}}{{#if this.field}} — {{this.field}}{{/if}}</div>
          </div>
          <div class="entry-date">{{#if this.startDate}}{{this.startDate}}{{/if}}{{#if this.endDate}} – {{this.endDate}}{{/if}}</div>
        </div>
        {{#if this.description}}<div class="entry-description">{{this.description}}</div>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if sections.skills.length}}
    <section class="section">
      <h2 class="section-title">Skills</h2>
      <div class="skills-grid">
        {{#each sections.skills}}
        <span class="skill-tag">{{this.name}}{{#if this.level}}<span class="skill-level">({{this.level}})</span>{{/if}}</span>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if sections.certifications.length}}
    <section class="section">
      <h2 class="section-title">Certifications</h2>
      {{#each sections.certifications}}
      <div class="entry">
        <div class="entry-header">
          <div>
            <div class="entry-title">{{this.name}}</div>
            <div class="entry-subtitle">{{this.issuer}}</div>
          </div>
          <div class="entry-date">{{#if this.issueDate}}{{this.issueDate}}{{/if}}</div>
        </div>
      </div>
      {{/each}}
    </section>
    {{/if}}
  </div>
</body>
</html>
