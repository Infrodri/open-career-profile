<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{personalInfo.fullName}} - Hoja de Vida</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      font-size: 10pt;
      line-height: 1.5;
      color: #2d2d2d;
    }
    .container { max-width: 800px; margin: 0 auto; padding: 20px; }
    .header {
      text-align: center;
      border-bottom: 2px solid #1e3a5f;
      padding-bottom: 14px;
      margin-bottom: 20px;
    }
    .header h1 { font-size: 20pt; color: #1e3a5f; margin-bottom: 4px; }
    .profesiones { font-size: 10pt; color: #555; margin-bottom: 6px; }
    .contact-info { font-size: 9pt; color: #555; }
    .contact-info span { margin: 0 6px; }
    .summary { margin-bottom: 20px; font-style: italic; color: #444; font-size: 10pt; }
    .section { margin-bottom: 16px; }
    .section-title {
      font-size: 11pt;
      color: #1e3a5f;
      border-bottom: 1px solid #ddd;
      padding-bottom: 3px;
      margin-bottom: 10px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .entry { margin-bottom: 10px; padding-left: 8px; border-left: 2px solid #e0e0e0; }
    .entry-title { font-weight: 600; font-size: 10pt; }
    .entry-subtitle { color: #555; font-size: 9pt; }
    .entry-date { color: #777; font-size: 8pt; }
    .entry-description { margin-top: 3px; font-size: 9pt; color: #444; }
    .entry-contenido { margin-top: 3px; font-size: 8pt; color: #555; }
    .skills-grid { display: flex; flex-wrap: wrap; gap: 6px; }
    .skill-tag {
      background: #e8f0fe;
      color: #1e3a5f;
      padding: 2px 8px;
      border-radius: 3px;
      font-size: 8pt;
    }
    .idioma-item { display: inline-block; margin-right: 16px; font-size: 9pt; }
    .idioma-level { color: #777; font-size: 8pt; }
  </style>
</head>
<body>
  <div class="container">
    <header class="header">
      <h1>{{personalInfo.fullName}}</h1>
      {{#if personalInfo.profesiones.length}}
      <div class="profesiones">{{#each personalInfo.profesiones}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</div>
      {{/if}}
      <div class="contact-info">
        {{#if personalInfo.email}}<span>{{personalInfo.email}}</span>{{/if}}
        {{#if personalInfo.phone}}<span>{{personalInfo.phone}}</span>{{/if}}
        {{#if personalInfo.identityDocument}}<span>CI: {{personalInfo.identityDocument}}</span>{{/if}}
        {{#if personalInfo.city}}<span>{{personalInfo.city}}{{#if personalInfo.country}}, {{personalInfo.country}}{{/if}}</span>{{/if}}
      </div>
    </header>

    {{#if personalInfo.summary}}
    <div class="summary">
      <p>{{personalInfo.summary}}</p>
    </div>
    {{/if}}

    {{!-- FORMACIÓN ACADÉMICA --}}
    {{#if sections.formacionAcademica.length}}
    <section class="section">
      <h2 class="section-title">Formación Académica</h2>
      {{#each sections.formacionAcademica}}
      <div class="entry">
        <div class="entry-title">{{this.title}}</div>
        <div class="entry-subtitle">{{this.institution}}</div>
        <div class="entry-date">{{this.startDate}}{{#if this.endDate}} – {{this.endDate}}{{/if}}</div>
        {{#if this.detalle}}<div class="entry-description">{{this.detalle}}</div>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{!-- POSTGRADO --}}
    {{#if sections.postgrado.length}}
    <section class="section">
      <h2 class="section-title">Postgrado</h2>
      {{#each sections.postgrado}}
      <div class="entry">
        <div class="entry-title">{{this.title}}</div>
        <div class="entry-subtitle">{{this.institution}}</div>
        <div class="entry-date">{{this.startDate}}{{#if this.endDate}} – {{this.endDate}}{{/if}}</div>
        {{#if this.detalle}}<div class="entry-description">{{this.detalle}}</div>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{!-- EXPERIENCIA ADMINISTRATIVA --}}
    {{#if sections.experienciaAdministrativa.length}}
    <section class="section">
      <h2 class="section-title">Experiencia Laboral</h2>
      {{#each sections.experienciaAdministrativa}}
      <div class="entry">
        <div class="entry-title">{{this.position}}</div>
        <div class="entry-subtitle">{{this.institution}}{{#if this.location}} — {{this.location}}{{/if}}</div>
        <div class="entry-date">{{this.startDate}}{{#if this.endDate}} – {{this.endDate}}{{else}} – Presente{{/if}}</div>
        {{#if this.description}}<div class="entry-description">{{this.description}}</div>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{!-- EXPERIENCIA DOCENTE --}}
    {{#if sections.experienciaDocente.length}}
    <section class="section">
      <h2 class="section-title">Experiencia Docente</h2>
      {{#each sections.experienciaDocente}}
      <div class="entry">
        <div class="entry-title">{{this.position}}</div>
        <div class="entry-subtitle">{{this.institution}}</div>
        <div class="entry-date">{{this.startDate}}{{#if this.endDate}} – {{this.endDate}}{{/if}}</div>
        {{#if this.description}}<div class="entry-description">{{this.description}}</div>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{!-- EXPERIENCIA EN DESARROLLO --}}
    {{#if sections.experienciaDesarrollo.length}}
    <section class="section">
      <h2 class="section-title">Experiencia en Desarrollo</h2>
      {{#each sections.experienciaDesarrollo}}
      <div class="entry">
        <div class="entry-title">{{this.position}}</div>
        <div class="entry-subtitle">{{this.institution}}</div>
        <div class="entry-date">{{this.startDate}}{{#if this.endDate}} – {{this.endDate}}{{/if}}</div>
        {{#if this.description}}<div class="entry-description">{{this.description}}</div>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{!-- CURSOS DE ESPECIALIDAD --}}
    {{#if sections.cursosEspecialidad.length}}
    <section class="section">
      <h2 class="section-title">Cursos de Especialidad</h2>
      {{#each sections.cursosEspecialidad}}
      <div class="entry">
        <div class="entry-title">{{this.name}}</div>
        <div class="entry-subtitle">{{this.issuer}}</div>
        {{#if this.issueDate}}<div class="entry-date">{{this.issueDate}}</div>{{/if}}
        {{#if this.contenido.length}}<div class="entry-contenido">{{#each this.contenido}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</div>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{!-- CERTIFICACIONES CIBERSEGURIDAD --}}
    {{#if sections.certificacionesCiberseguridad.length}}
    <section class="section">
      <h2 class="section-title">Certificaciones de Ciberseguridad</h2>
      {{#each sections.certificacionesCiberseguridad}}
      <div class="entry">
        <div class="entry-title">{{this.name}}</div>
        <div class="entry-subtitle">{{this.issuer}}</div>
        {{#if this.issueDate}}<div class="entry-date">{{this.issueDate}}</div>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{!-- CERTIFICACIONES SISTEMAS INSTITUCIONALES --}}
    {{#if sections.certificacionesSistemasInstitucionales.length}}
    <section class="section">
      <h2 class="section-title">Certificaciones de Sistemas Institucionales</h2>
      {{#each sections.certificacionesSistemasInstitucionales}}
      <div class="entry">
        <div class="entry-title">{{this.name}}</div>
        <div class="entry-subtitle">{{this.issuer}}</div>
        {{#if this.issueDate}}<div class="entry-date">{{this.issueDate}}</div>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{!-- CURSOS ADMINISTRATIVOS --}}
    {{#if sections.cursosAdministrativos.length}}
    <section class="section">
      <h2 class="section-title">Cursos y Talleres Administrativos</h2>
      {{#each sections.cursosAdministrativos}}
      <div class="entry">
        <div class="entry-title">{{this.name}}</div>
        <div class="entry-subtitle">{{this.issuer}}</div>
        {{#if this.issueDate}}<div class="entry-date">{{this.issueDate}}</div>{{/if}}
        {{#if this.detalle}}<div class="entry-description">{{this.detalle}}</div>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{!-- CURSOS PROGRAMACIÓN --}}
    {{#if sections.cursosProgramacion.length}}
    <section class="section">
      <h2 class="section-title">Cursos de Programación</h2>
      {{#each sections.cursosProgramacion}}
      <div class="entry">
        <div class="entry-title">{{this.name}}</div>
        <div class="entry-subtitle">{{this.issuer}}</div>
        {{#if this.issueDate}}<div class="entry-date">{{this.issueDate}}</div>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{!-- CURSOS GENERALES --}}
    {{#if sections.cursosGenerales.length}}
    <section class="section">
      <h2 class="section-title">Congresos, Conferencias y Talleres</h2>
      {{#each sections.cursosGenerales}}
      <div class="entry">
        <div class="entry-title">{{this.name}}</div>
        <div class="entry-subtitle">{{this.issuer}}</div>
        {{#if this.issueDate}}<div class="entry-date">{{this.issueDate}}</div>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{!-- RECONOCIMIENTOS --}}
    {{#if sections.reconocimientosExpositor.length}}
    <section class="section">
      <h2 class="section-title">Reconocimientos como Expositor</h2>
      {{#each sections.reconocimientosExpositor}}
      <div class="entry">
        <div class="entry-title">{{this.name}}</div>
        <div class="entry-subtitle">{{this.issuer}}</div>
        {{#if this.issueDate}}<div class="entry-date">{{this.issueDate}}</div>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if sections.reconocimientosRepresentacion.length}}
    <section class="section">
      <h2 class="section-title">Reconocimientos por Representación</h2>
      {{#each sections.reconocimientosRepresentacion}}
      <div class="entry">
        <div class="entry-title">{{this.name}}</div>
        <div class="entry-subtitle">{{this.issuer}}</div>
        {{#if this.issueDate}}<div class="entry-date">{{this.issueDate}}</div>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if sections.reconocimientosLaborales.length}}
    <section class="section">
      <h2 class="section-title">Reconocimientos Laborales</h2>
      {{#each sections.reconocimientosLaborales}}
      <div class="entry">
        <div class="entry-title">{{this.name}}</div>
        {{#if this.issuer}}<div class="entry-subtitle">{{this.issuer}}</div>{{/if}}
        {{#if this.issueDate}}<div class="entry-date">{{this.issueDate}}</div>{{/if}}
        {{#if this.motivo}}<div class="entry-description">{{this.motivo}}</div>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{!-- IDIOMAS --}}
    {{#if sections.idiomas.length}}
    <section class="section">
      <h2 class="section-title">Idiomas</h2>
      {{#each sections.idiomas}}
      <span class="idioma-item">{{this.name}} <span class="idioma-level">({{this.level}})</span></span>
      {{/each}}
    </section>
    {{/if}}

    {{!-- HABILIDADES --}}
    {{#if sections.habilidades.length}}
    <section class="section">
      <h2 class="section-title">Habilidades</h2>
      <div class="skills-grid">
        {{#each sections.habilidades}}
        <span class="skill-tag">{{this.name}}{{#if this.level}} ({{this.level}}){{/if}}</span>
        {{/each}}
      </div>
    </section>
    {{/if}}

  </div>
</body>
</html>
