<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{personalInfo.fullName}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Helvetica Neue', Arial, sans-serif;
      font-size: 10pt;
      line-height: 1.4;
      color: #333;
    }
    .container { max-width: 700px; margin: 0 auto; padding: 16px; }
    .header { margin-bottom: 16px; }
    .header h1 { font-size: 18pt; font-weight: 700; margin-bottom: 2px; }
    .contact { font-size: 9pt; color: #666; }
    .contact span::after { content: " · "; }
    .contact span:last-child::after { content: ""; }
    .summary { font-size: 9pt; color: #555; margin-bottom: 14px; }
    .section { margin-bottom: 14px; }
    .section-title {
      font-size: 9pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #000;
      margin-bottom: 6px;
      padding-bottom: 2px;
      border-bottom: 1px solid #ccc;
    }
    .entry { margin-bottom: 8px; }
    .entry-line { display: flex; justify-content: space-between; }
    .entry-title { font-weight: 600; font-size: 10pt; }
    .entry-org { font-size: 9pt; color: #555; }
    .entry-date { font-size: 8pt; color: #888; }
    .entry-desc { font-size: 9pt; color: #555; margin-top: 2px; }
    .skills-list { font-size: 9pt; }
    .skill-item { display: inline; }
    .skill-item::after { content: ", "; }
    .skill-item:last-child::after { content: ""; }
  </style>
</head>
<body>
  <div class="container">
    <header class="header">
      <h1>{{personalInfo.fullName}}</h1>
      <div class="contact">
        {{#if personalInfo.email}}<span>{{personalInfo.email}}</span>{{/if}}
        {{#if personalInfo.phone}}<span>{{personalInfo.phone}}</span>{{/if}}
        {{#if personalInfo.city}}<span>{{personalInfo.city}}{{#if personalInfo.country}}, {{personalInfo.country}}{{/if}}</span>{{/if}}
      </div>
    </header>

    {{#if personalInfo.summary}}
    <div class="summary">{{personalInfo.summary}}</div>
    {{/if}}

    {{#if sections.workExperience.length}}
    <section class="section">
      <h2 class="section-title">Experience</h2>
      {{#each sections.workExperience}}
      <div class="entry">
        <div class="entry-line">
          <span class="entry-title">{{this.position}}</span>
          <span class="entry-date">{{this.startDate}}{{#if this.endDate}} – {{this.endDate}}{{/if}}</span>
        </div>
        <div class="entry-org">{{this.institution}}</div>
        {{#if this.description}}<div class="entry-desc">{{this.description}}</div>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if sections.education.length}}
    <section class="section">
      <h2 class="section-title">Education</h2>
      {{#each sections.education}}
      <div class="entry">
        <div class="entry-line">
          <span class="entry-title">{{this.title}}</span>
          <span class="entry-date">{{#if this.startDate}}{{this.startDate}}{{/if}}{{#if this.endDate}} – {{this.endDate}}{{/if}}</span>
        </div>
        <div class="entry-org">{{this.institution}}</div>
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if sections.skills.length}}
    <section class="section">
      <h2 class="section-title">Skills</h2>
      <div class="skills-list">
        {{#each sections.skills}}<span class="skill-item">{{this.name}}</span>{{/each}}
      </div>
    </section>
    {{/if}}

    {{#if sections.certifications.length}}
    <section class="section">
      <h2 class="section-title">Certifications</h2>
      {{#each sections.certifications}}
      <div class="entry">
        <div class="entry-line">
          <span class="entry-title">{{this.name}}</span>
          <span class="entry-date">{{#if this.issueDate}}{{this.issueDate}}{{/if}}</span>
        </div>
        <div class="entry-org">{{this.issuer}}</div>
      </div>
      {{/each}}
    </section>
    {{/if}}
  </div>
</body>
</html>
