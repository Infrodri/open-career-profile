{
  "name": "@ocp/persistence",
  "version": "0.0.1",
  "private": true,
  "description": "Prisma persistence adapter for Open Career Profile",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prisma:generate": "prisma generate --schema=src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=src/prisma/schema.prisma"
  },
  "dependencies": {
    "@ocp/core": "*",
    "@prisma/client": "6.9.0"
  },
  "devDependencies": {
    "prisma": "6.9.0",
    "vitest": "3.1.4",
    "typescript": "5.8.3"
  }
}
