generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("OCP_DATABASE_URL")
}

model Profile {
  id               String   @id @default(uuid())
  fullName         String
  email            String?
  phone            String?
  city             String?
  country          String?
  summary          String?
  photo            String?
  birthDate        String?
  identityDocument String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  links          ProfileLink[]
  workExperience WorkExperience[]
  education      Education[]
  certifications Certification[]
  courses        Course[]
  languages      Language[]
  skills         Skill[]
  projects       Project[]
  publications   Publication[]
  awards         Award[]
  affiliations   Affiliation[]
  volunteering   Volunteering[]
  references     Reference[]
  documents      Document[]
}

model ProfileLink {
  id        String  @id @default(uuid())
  profileId String
  label     String
  url       String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model WorkExperience {
  id           String   @id @default(uuid())
  profileId    String
  position     String
  institution  String
  startDate    String
  endDate      String?
  description  String?
  achievements String[]
  location     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Education {
  id          String   @id @default(uuid())
  profileId   String
  title       String
  institution String
  startDate   String?
  endDate     String?
  description String?
  field       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Certification {
  id               String   @id @default(uuid())
  profileId        String
  name             String
  issuer           String
  issueDate        String?
  expirationDate   String?
  verificationCode String?
  verificationUrl  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Course {
  id             String   @id @default(uuid())
  profileId      String
  name           String
  institution    String?
  completionDate String?
  duration       String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Language {
  id            String   @id @default(uuid())
  profileId     String
  name          String
  level         String
  certification String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Skill {
  id        String   @id @default(uuid())
  profileId String
  name      String
  category  String?
  level     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Project {
  id           String   @id @default(uuid())
  profileId    String
  name         String
  description  String?
  role         String?
  startDate    String?
  endDate      String?
  url          String?
  technologies String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Publication {
  id          String   @id @default(uuid())
  profileId   String
  title       String
  type        String?
  date        String?
  publisher   String?
  url         String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Award {
  id          String   @id @default(uuid())
  profileId   String
  name        String
  issuer      String?
  date        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Affiliation {
  id        String   @id @default(uuid())
  profileId String
  organization String
  role      String?
  startDate String?
  endDate   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Volunteering {
  id          String   @id @default(uuid())
  profileId   String
  organization String
  role        String?
  description String?
  startDate   String?
  endDate     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Reference {
  id           String   @id @default(uuid())
  profileId    String
  fullName     String
  relationship String?
  institution  String?
  phone        String?
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Document {
  id            String   @id @default(uuid())
  // Optional: a document can be uploaded before any profile exists.
  // It gets linked to a profile when the extracted data is imported.
  profileId     String?
  fileName      String
  mimeType      String
  sizeBytes     Int
  storagePath   String
  documentType  String?
  extractedText String? @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profile       Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  evidences     Evidence[]

  @@index([profileId])
}

model Evidence {
  id          String   @id @default(uuid())
  documentId  String
  sectionType String
  entryId     String
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, sectionType, entryId])
  @@index([sectionType, entryId])
}
